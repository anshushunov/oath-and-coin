bin/
obj/
artifacts/
.vs/
*.user
game/.godot/

# Working material of the agent workflow — plans, specs, hand-off notes.
# It stays on the workstation and out of the repository on purpose: once a
# plan's content has moved into docs/decisions/, keeping the plan under git
# leaves two sources of truth, and the stale one is the one somebody reads.
# Deleting it outright would throw away notes that are still useful while the
# work is fresh, so it lives locally instead.
docs/superpowers/
.superpowers/

# TypeScript workspace (ADR-010). The lockfile is committed and the installed
# tree is not: pnpm-lock.yaml is the authority on every transitive version, and
# `--frozen-lockfile` is what makes a clone reproduce the same graph.
node_modules/
dist/
*.tsbuildinfo

# Playwright downloads its browsers outside the repository, but a locally
# invoked run without the config's outputDir still drops these two here.
playwright-report/
test-results/
