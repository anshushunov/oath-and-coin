# ADR-010 §123: every direct dependency is pinned to an exact version, and the
# lockfile is the authority on the transitive graph. `save-exact` makes that the
# default outcome of `pnpm add` rather than something a reviewer has to notice
# was forgotten — a caret added by hand still fails the workspace pin test, but
# a rule that only fires in review is a rule that fires late.
save-exact=true

# `engines` in package.json is advisory to npm and to pnpm alike unless this is
# on. The Node version is not a preference here: Vite 8 requires >=22.12, the
# Electron package ships a binary built against a specific ABI, and a developer
# on an older Node would get failures that look like broken code.
engine-strict=true

# The default is `true`, which hoists the transitive graph into a flat
# node_modules and lets a package import something it never declared. That
# failure surfaces on the machine where the hoisting happens to differ — a CI
# runner, a fresh clone — and never on the one where the code was written.
hoist=false
