; Engine configuration file — pins the visual environment for the runtime
; harness (see the runtime-harness plan, Task 7). Every value below is meant
; to be an input a report can quote, never a property of whichever machine
; happens to run it: window size, window mode and stretch policy decide what
; a screenshot actually shows, and the renderer decides whether the run works
; at all on a weak CI agent. ADR-001 pins the engine itself the same way, at
; the version in this project's Godot.NET.Sdk reference.

config_version=5

[application]

config/name="Oath & Coin"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

; 1280x720, windowed, with a fixed stretch policy — never left to the OS
; default, a previous run's override.cfg, or whatever monitor happens to be
; attached. OathAndCoin.GameProtocol.GameArguments carries the same
; width/height as an explicit argv input (see GameInvocation.BuildArgv), so
; this baseline and the report agree on where the number came from.
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="OathAndCoin.Game"

[internationalization]

; The baseline this project ships with. The locale that actually governs one
; run travels explicitly through argv (--locale, see GameArguments) and is
; applied at startup by Main._Ready via TranslationServer.SetLocale — this
; fallback only matters when that never runs, e.g. the editor opening the
; project directly.
locale/fallback="en"

[rendering]

; GL Compatibility, not Forward+: it runs the same way on a headless CI agent
; with no dedicated GPU as it does on a developer's machine, which a
; screenshot-based check depends on more than it depends on visual fidelity.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
