{
  "name": "oath-and-coin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Oath & Coin — TypeScript workspace (ADR-010 full migration, Task 3)",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=24.12.0 <25.0.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "typecheck": "tsc --build tsconfig.json --force",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps packages tests scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "node scripts/generate-schemas.mjs",
    "schema:check": "node scripts/check-schemas.mjs",
    "bench:decision": "node scripts/benchmark-decision.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "build": "node scripts/build-workspace.mjs",
    "package:desktop": "node scripts/package-desktop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
