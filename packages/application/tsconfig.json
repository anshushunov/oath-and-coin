{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Empty for the same reason `packages/presentation` and `packages/simulation`
    // keep it empty. This layer is inside the browser bundle (`ADR-010` §59:
    // content ← application ← apps/web), so a `node:fs` that typechecked here
    // would break the page rather than the build; and the whole point of
    // `ContentSourcePort` is that this layer does not know where files come from.
    // Without this entry `@types/node` is visible from the root devDependencies
    // and `readFileSync` would typecheck inside the layer whose boundary rule
    // forbids it.
    "types": [],

    // `DOM` is here for one reason and it is not the DOM. This project compiles
    // the sources of everything it imports, and `packages/content` reads bytes
    // through `TextDecoder('utf-8', { fatal: true })` — the strict decode that
    // refuses a malformed content file. `TextDecoder` and `TextEncoder` exist in
    // Node, in every browser and in Electron, but they are declared by
    // `lib.dom.d.ts` and by `@types/node`, and by nothing in `ES2023`. With
    // neither, this project fails to build on a file it does not own.
    //
    // The cost is named rather than hidden: with `DOM` in scope, `document` and
    // `window` typecheck here too, and `ADR-010` forbids this layer to touch
    // either. The compiler cannot make that distinction, so a scoped
    // `no-restricted-globals` in `eslint.config.js` does — the same division of
    // labour the simulation's ban on the clock and on global randomness already
    // uses, and it carries its own mutant.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src"]
}
