{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oath-and-coin.invalid/schemas/contract.schema.json",
  "title": "Contract definition",
  "description": "A contract offer's authored terms. Ranges here are the same numbers ContentBounds enforces in the loader; SchemaAgreementTests asserts the two never drift apart.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name_key",
    "patron_fee",
    "risk",
    "required_crew",
    "needs",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 6,
      "description": "Version of this content format (TDD 11.1). Pinned by const so a file authored for a later format is refused by tooling, not read under today's assumptions; ContentSet.SupportedContentSchemaVersion states the same number and SchemaAgreementTests keeps the two equal."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$",
      "description": "Stable namespaced identifier; the pattern is ContentId's own format."
    },
    "display_name_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
      "description": "Localization key, never a player-facing literal (TDD 11.1). The pattern is the artifact-safe character set: this key travels unchanged into HeroState and from there into the canonical determinism artifact, where non-ASCII text and control characters are exactly the inputs the frozen corpus records the C# writer and RFC 8785 disagreeing on."
    },
    "patron_fee": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "risk": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "required_crew": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "needs": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 3,
      "propertyNames": {
        "type": "string",
        "enum": [
          "frontline",
          "undead_knowledge",
          "wilderness"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "description": "What this job asks for, and how much of each (RESOLUTION_SPEC 2.3). Two or three needs — one makes taking the strongest hero the answer to every contract, the kill-criterion MVP_PLAN 3.2 names. Every weight is strictly positive: a need of weight 0 is a second entry asking for nothing, which is the one-need contract by the back door."
    },
    "tags": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      },
      "description": "Tags a hero's traits can react to (HERO_DECISION_SPEC §1.4)."
    },
    "negotiable_tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      },
      "description": "Exactly two mutually exclusive method tags the player chooses one of (NEGOTIATION_SPEC 2.4). Absent means the contract is negotiated on money and promise only."
    },
    "battle": {
      "type": "object",
      "properties": {
        "objectives": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "frontline",
              "undead_knowledge",
              "wilderness"
            ]
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "subdue"
                  },
                  "targets": {
                    "minItems": 1,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                },
                "required": [
                  "kind",
                  "targets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "protect"
                  },
                  "ward": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                },
                "required": [
                  "kind",
                  "ward"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "hold"
                  },
                  "rounds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  }
                },
                "required": [
                  "kind",
                  "rounds"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "foes": {
          "minItems": 2,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "vanguard",
                  "support",
                  "rear",
                  "breaker"
                ]
              },
              "cell": {
                "type": "object",
                "properties": {
                  "row": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      },
                      {
                        "type": "number",
                        "const": 3
                      }
                    ]
                  },
                  "column": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      },
                      {
                        "type": "number",
                        "const": 3
                      }
                    ]
                  }
                },
                "required": [
                  "row",
                  "column"
                ],
                "additionalProperties": false
              },
              "combat": {
                "type": "object",
                "properties": {
                  "might": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "guard": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "aim": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "focus": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "care": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "might",
                  "guard",
                  "aim",
                  "focus",
                  "care"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "role",
              "cell",
              "combat"
            ],
            "additionalProperties": false
          }
        },
        "wards": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "vanguard",
                  "support",
                  "rear",
                  "breaker"
                ]
              },
              "cell": {
                "type": "object",
                "properties": {
                  "row": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      },
                      {
                        "type": "number",
                        "const": 3
                      }
                    ]
                  },
                  "column": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      },
                      {
                        "type": "number",
                        "const": 3
                      }
                    ]
                  }
                },
                "required": [
                  "row",
                  "column"
                ],
                "additionalProperties": false
              },
              "combat": {
                "type": "object",
                "properties": {
                  "might": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "guard": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "aim": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "focus": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "care": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "might",
                  "guard",
                  "aim",
                  "focus",
                  "care"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "role",
              "cell",
              "combat"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "objectives",
        "foes",
        "wards"
      ],
      "additionalProperties": false,
      "description": "The fight this contract leads to (ADR-016 1, COMBAT_SPEC 6.2). Absent means the contract never goes to a battle and is settled by the abstract resolver — the field is the routing rule (ADR-014 1), not extra detail. Every combatant key is prefixed by the loader with foe: or ward:, so a file naming 'wight' cannot name a hero."
    }
  }
}
