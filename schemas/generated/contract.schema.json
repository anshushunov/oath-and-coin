{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oath-and-coin.invalid/schemas/generated/contract.schema.json",
  "title": "Contract definition",
  "description": "Generated from the Zod contracts in packages/content/src/schemas.ts — do not edit. Regenerate with `pnpm schema:generate`; `pnpm schema:check` fails if this file and the contracts disagree, or if the numbers here drift from the hand-written schema the .NET stack still reads until cutover.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
    },
    "display_name_key": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "patron_fee": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "risk": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "required_crew": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "tags": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      }
    },
    "negotiable_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "display_name_key",
    "patron_fee",
    "risk",
    "required_crew",
    "tags"
  ],
  "additionalProperties": false
}
