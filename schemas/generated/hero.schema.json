{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oath-and-coin.invalid/schemas/generated/hero.schema.json",
  "title": "Hero definition",
  "description": "Generated from the Zod contracts in packages/content/src/schemas.ts — do not edit. Regenerate with `pnpm schema:generate`; `pnpm schema:check` fails if this file and the contracts disagree, or if the numbers here drift from the hand-written schema the .NET stack still reads until cutover.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 5
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
    },
    "display_name_key": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "greed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "caution": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "pride": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "trust_in_guild": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "capability": {
      "type": "object",
      "properties": {
        "expertise": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "frontline",
              "undead_knowledge",
              "wilderness"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "required": [
        "expertise"
      ],
      "additionalProperties": false
    },
    "combat": {
      "type": "object",
      "properties": {
        "might": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "guard": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "aim": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "focus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "care": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "might",
        "guard",
        "aim",
        "focus",
        "care"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "string",
      "enum": [
        "vanguard",
        "support",
        "rear",
        "breaker"
      ]
    },
    "traits": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      }
    },
    "relationships": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hero": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
          },
          "weight": {
            "type": "integer",
            "minimum": -20,
            "maximum": 20
          }
        },
        "required": [
          "hero",
          "weight"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "display_name_key",
    "greed",
    "caution",
    "pride",
    "trust_in_guild",
    "capability",
    "combat",
    "role",
    "traits",
    "relationships"
  ],
  "additionalProperties": false
}
