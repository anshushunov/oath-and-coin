<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\OathAndCoin.Harness\OathAndCoin.Harness.csproj" />

    <!--
      ProcessRunnerTests launches the fake game as a real child process, so
      it needs the built .exe, not a compiled reference to its types.
      ReferenceOutputAssembly="false" still builds the project (so the exe
      exists) without adding its assembly to this project's references.
    -->
    <ProjectReference Include="..\OathAndCoin.Harness.FakeGame\OathAndCoin.Harness.FakeGame.csproj"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\tiny.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    OathAndCoin.Harness.FakeGame.csproj builds its apphost with the
    platform's native executable extension: ".exe" on Windows, no extension
    on Linux/macOS. Microsoft.NET.Sdk.Shared.targets computes that same fact
    as $(_NativeExecutableExtension) (the property $(RunCommand) is built
    from for `dotnet run`), but that property is only populated for a
    project that builds an apphost itself (OutputType=Exe with
    UseAppHost=true) — which this test project is not, so referencing it
    directly here would silently resolve empty even on Windows.
    $([MSBuild]::IsOSPlatform('Windows')) is the same intrinsic the SDK's own
    RID inference (Microsoft.NET.RuntimeIdentifierInference.targets) uses to
    answer "is this build running on Windows", so it holds regardless of
    this project's own output type.
  -->
  <PropertyGroup>
    <_FakeGameExecutableExtension Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_FakeGameExecutableExtension>
  </PropertyGroup>

  <!--
    Same mechanism OathAndCoin.Content.Tests uses for its fixture roots
    (ContentRoot/SchemaRoot/ScenarioRoot): the path is resolved by MSBuild at
    build time, so it is correct in every checkout layout without walking up
    looking for `.git` (a file, not a directory, inside a worktree).

    FakeGamePath is built with System.IO.Path.Combine (via an MSBuild
    property function) rather than a literal string, so no separator is
    hardcoded — the value is a real path on whichever OS MSBuild is running
    on.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FakeGamePath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', 'OathAndCoin.Harness.FakeGame', 'bin', '$(Configuration)', '$(TargetFramework)', 'OathAndCoin.Harness.FakeGame$(_FakeGameExecutableExtension)'))</_Parameter2>
    </AssemblyAttribute>

    <!--
      SmokeRunTests drives SmokeRun.Execute end to end against a fake process
      runner. The run reads the repository's real scenario manifests and
      game/project.godot — the same inputs a real run reads — so it needs the
      checkout's root, resolved by MSBuild for the same reason the paths above
      are. Combine, not a literal `..\..`, for the same reason as
      FakeGamePath above: `\` is not a path separator on Linux.
    -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', '..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
