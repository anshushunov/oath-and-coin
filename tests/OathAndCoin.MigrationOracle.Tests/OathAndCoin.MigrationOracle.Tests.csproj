<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Production assemblies only. This project deliberately does not reference
    `tools/OathAndCoin.MigrationOracle`: the corpus is validated as data, by a
    reader that re-derives the same facts from the production loaders, rules
    and factory. A test that went through the exporter's own types would agree
    with the exporter about anything the exporter got wrong, which is the one
    failure an oracle cannot afford.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\adapters\OathAndCoin.Content\OathAndCoin.Content.csproj" />
    <ProjectReference Include="..\..\adapters\OathAndCoin.Presentation\OathAndCoin.Presentation.csproj" />
  </ItemGroup>

  <!--
    Roots are resolved from assembly metadata rather than by walking up to a
    `.git` entry, for the reason `OathAndCoin.Content.Tests` already records:
    in a worktree `.git` is a file, not a directory, and the walk breaks in
    exactly that layout.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../..</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OracleRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../migration/oracle/v1</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
