<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\adapters\OathAndCoin.Presentation\OathAndCoin.Presentation.csproj" />

    <!--
      Task 11's catalogue-completeness test loads content and locale
      directly (ContentSet.Load, LocaleCatalogue.Load) rather than only
      consuming ScenarioOutcome's shape — an explicit reference states that,
      even though OathAndCoin.Presentation's own ProjectReference chain
      already makes the assembly available transitively.
    -->
    <ProjectReference Include="..\..\adapters\OathAndCoin.Content\OathAndCoin.Content.csproj" />
  </ItemGroup>

  <!--
    Reuses OathAndCoin.Content.Tests' fixture locator rather than duplicating
    it: this project runs the same gate 0 scenario against content/ to build
    the read model it tests, so it needs the same ContentRoot/ScenarioRoot
    lookup. RepositoryFixtures is internal, but a linked source file compiles
    directly into this assembly, so that is not a visibility problem.
  -->
  <ItemGroup>
    <Compile Include="..\OathAndCoin.Content.Tests\RepositoryFixtures.cs" Link="RepositoryFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ContentRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../content</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ScenarioRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../scenarios</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    One shared statement of the filesystem types this side of the boundary may
    not reference — linked, the same way RepositoryFixtures already is,
    because the core guard and the presentation guard used to keep two lists
    and the shorter one silently allowed Path, FileInfo and DirectoryInfo.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\ForbiddenTypes.cs" Link="ForbiddenTypes.cs" />
  </ItemGroup>

</Project>
